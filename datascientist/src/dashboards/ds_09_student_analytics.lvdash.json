        },
        {
          "widget": {
            "name": "table-dept-detail",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "by_dept",
                  "fields": [
                    { "name": "department", "expression": "`department`" },
                    { "name": "division", "expression": "`division`" },
                    { "name": "enrollments", "expression": "`enrollments`" },
                    { "name": "avg_gpa", "expression": "`avg_gpa`" }
